@page "/404"
@using Microsoft.AspNetCore.Components


<div class="content">
    <div class="notfound-hero card" role="main" aria-labelledby="notfound-title">


        <h1 id="notfound-title"> 404 - Page non trouvée</h1>

        <p class="kicker">La page que vous cherchez n'existe pas ou a été déplacée. Vérifiez l'URL ou revenez à l'accueil.</p>

        <div class="cta" role="navigation" aria-label="Actions">
            <a class="btn btn-primary" href="/">Retour à l'accueil</a>
        </div>
    </div>
</div>