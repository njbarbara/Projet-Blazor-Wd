@page "/Admin/addUser"

<h3>@Localizer["Add_Title"]</h3>

<EditForm Model="@Item" OnValidSubmit="@HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label" for="name">
            @Localizer["Label_Name"]
            <InputText class="form-control" id="name" placeholder="@Localizer["Placeholder_Name"]" @bind-Value="Item.Name" />
        </label>
    </div>



    <div class="mb-3">
        <label class="form-label" for="email">
            @Localizer["Label_Email"]
            <InputText class="form-control" id="email" placeholder="@Localizer["Placeholder_Email"]" @bind-Value="Item.Email" />
        </label>
    </div>

    <div class="mb-3 form-check">
        <InputCheckbox class="form-check-input" id="isAdmin" @bind-Value="Item.IsAdmin" />
        <label class="form-check-label" for="isAdmin">
            @Localizer["Label_IsAdmin"]
        </label>
    </div>



    <button type="submit">@Localizer["Button_Submit"]</button>
</EditForm>

@code {
    

    // Préservé : Item et HandleValidSubmit doivent exister dans le partial class / code-behind du composant
}